# Secrets only. Every non secret value lives in config.yaml at the repo root.
# Save this file as .env. Do not add a UTF-8 BOM: it silently renames the first
# variable and the app will not see it.

# --- Chat model provider -----------------------------------------------------
# Every model request goes to one provider through one key. The model, its base
# url and the env var holding its key are all in the llm block of config.yaml, so
# pointing the application at a different OpenAI-compatible provider is a config
# edit rather than a code change. The default is OpenRouter:
OPENROUTER_API_KEY=

# Any other provider's key, named by llm.api_key_env in config.yaml. Set one and
# point llm.base_url and llm.model at it to move off OpenRouter.
GROQ_API_KEY=
GOOGLE_API_KEY=

# --- Embeddings --------------------------------------------------------------
# Used for the Qdrant hybrid search vectors.
COHERE_API_KEY=

# --- Vector store ------------------------------------------------------------
QDRANT_URL=http://localhost:6333

# Postgres checkpointer for the LangGraph state. Leave empty to use the in memory saver.
DATABASE_URL=postgresql://langgraph_user:langgraph_password@localhost:5432/langgraph_db?sslmode=disable

# --- Tracing -----------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Secrets only. Every non secret value lives in config.yaml at the repo root.
# Save this file as .env. Do not add a UTF-8 BOM: it silently renames the first
# variable and the app will not see it.

# --- Chat model provider -----------------------------------------------------
# Every model request goes to https://openrouter.ai/api/v1 through this one key.
OPENROUTER_API_KEY=

# Ordered pool of OpenRouter model ids, tried one after another. The next model
# is only used for availability failures: a 429 that is not this key's own
# quota, a 5xx, a timeout or a dropped connection. An invalid key, a bad request
# or an exhausted account quota stops immediately.
#
# Ids come from https://openrouter.ai/api/v1/models. Only free, text chat models
# that support tool calling belong here. The list below is the default in
# config.yaml, so you only need this line to override it.
# OPENROUTER_MODELS=poolside/laguna-s-2.1:free,nvidia/nemotron-3-super-120b-a12b:free

# Optional. Tried first when it is also in the pool.
# OPENROUTER_PRIMARY_MODEL=poolside/laguna-s-2.1:free

# --- External provider fallback ---------------------------------------------
# Providers other than OpenRouter, tried in order once the OpenRouter pool
# cannot answer. Without these keys the application still runs, on OpenRouter
# alone. See `llm.fallback_order` in config.yaml for the order.

# Groq, through its own OpenAI compatible endpoint.
GROQ_API_KEY=
# Ordered, primary first. Must support tool calling, because it serves the agent.
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
# Optional. Tried first when it is also in GROQ_MODELS.
GROQ_MODEL=openai/gpt-oss-120b

# Google, as an agent fallback.
GOOGLE_API_KEY=

# Optional. The model the fallback uses. It must support tool calling, because
# it serves the agent, not just the router.
#   default : gemini-3.6-flash
#   note    : gemini-2.5-flash answers 404 for new users, and 3.7/3.8 answer
#             503 under current demand.
GOOGLE_MODEL=gemini-3.6-flash

# --- Embeddings --------------------------------------------------------------
# Used for the Qdrant hybrid search vectors.
COHERE_API_KEY=

# --- Vector store ------------------------------------------------------------
QDRANT_URL=http://localhost:6333

# Postgres checkpointer for the LangGraph state. Leave empty to use the in memory saver.
DATABASE_URL=postgresql://langgraph_user:langgraph_password@localhost:5432/langgraph_db?sslmode=disable

# --- Tracing -----------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
